# ─────────────────────────────────────────────────────────────
# AcmeTower — environment template (V0.1)
# Copy to `.env.local` (loaded by `next dev` and drizzle-kit) and fill in real
# values from the local password book. NEVER commit real secrets.
# On Cloudflare (production): set NEXT_PUBLIC_* as build-time env and the
# server-only vars as Wrangler secrets (`wrangler secret put <NAME>`).
# ─────────────────────────────────────────────────────────────

# --- Public app config (inlined into the client bundle at build time) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# --- Server-only: Supabase ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Optional server/admin key (service_role). Keep secret; only if RLS bypass is needed.
SUPABASE_SECRET_KEY=

# --- Server-only: Postgres (Drizzle / migrations / seeds) ---
# Use the Supabase connection string. Session pooler (port 5432) for local/dev;
# transaction pooler (port 6543) or Cloudflare Hyperdrive for edge/serverless.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
